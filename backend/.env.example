# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
# `.env` is gitignored — real credentials go there, never here.
#
# Values set as real environment variables override these.

# --- SMTP (email alerts) ---------------------------------------------------
# Leave SMTP_HOST blank to disable email alerts (in-app alerts still work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bhavyadora2002@gmail.com
# Gmail: 16-char App Password (requires 2-Step Verification). NOT your login password.
SMTP_PASSWORD=your-16-char-app-password
# Shown as the From: address; falls back to SMTP_USER if blank.
SMTP_FROM=bhavyadora2002@gmail.com

# --- Optional tuning -------------------------------------------------------
# How often the automatic risk/health check runs, in seconds (default 1 hour).
# ALERT_CHECK_INTERVAL_SECONDS=3600

# --- Database (defaults shown; usually you don't need these) ---------------
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=portfolio_db
